# TokenSea Environment Variables
# Copy this file to .env and fill in the values.
# Each DARIO_N_ section corresponds to one Team seat (user).
#
# For Team accounts:
#   - Each seat is a unique user in your Claude Team organization
#   - OAuth tokens are per-user, obtained via each user's Claude Code login
#   - Device ID and Account UUID come from each user's ~/.claude/.claude.json
#   - All seats share the org-level rate limit

# ============================================
# CPA (cli-proxy-api) Configuration
# ============================================

# Internal auth key between CPA and dario nodes.
# Each dario node's DARIO_API_KEY must match its corresponding entry in config.yaml.
DARIO_INTERNAL_KEY_1=dario-internal-key-1
DARIO_INTERNAL_KEY_2=dario-internal-key-2
DARIO_INTERNAL_KEY_3=dario-internal-key-3

# ============================================
# Seat 1 (dario-1) — Team user #1
# ============================================
# Obtain credentials from this user's machine:
#   OAuth tokens: ~/.claude/.credentials.json → claudeAiOauth.{accessToken, refreshToken, expiresAt}
#   Identity:     ~/.claude/.claude.json → {userID, oauthAccount.accountUuid}
DARIO_1_OAUTH_ACCESS_TOKEN=
DARIO_1_OAUTH_REFRESH_TOKEN=
DARIO_1_OAUTH_EXPIRES_AT=
DARIO_1_OAUTH_SCOPES=user:inference
DARIO_1_DEVICE_ID=
DARIO_1_ACCOUNT_UUID=
DARIO_1_ACCOUNT_ID=seat-1

# ============================================
# Seat 2 (dario-2) — Team user #2
# ============================================
DARIO_2_OAUTH_ACCESS_TOKEN=
DARIO_2_OAUTH_REFRESH_TOKEN=
DARIO_2_OAUTH_EXPIRES_AT=
DARIO_2_OAUTH_SCOPES=user:inference
DARIO_2_DEVICE_ID=
DARIO_2_ACCOUNT_UUID=
DARIO_2_ACCOUNT_ID=seat-2

# ============================================
# Seat 3 (dario-3) — Team user #3
# ============================================
DARIO_3_OAUTH_ACCESS_TOKEN=
DARIO_3_OAUTH_REFRESH_TOKEN=
DARIO_3_OAUTH_EXPIRES_AT=
DARIO_3_OAUTH_SCOPES=user:inference
DARIO_3_DEVICE_ID=
DARIO_3_ACCOUNT_UUID=
DARIO_3_ACCOUNT_ID=seat-3

# ============================================
# Optional: Template Configuration
# ============================================
# dario v6 ships a bundled cc-template-data.json kept fresh by upstream's
# cc-drift-template-watch CI. DARIO_NO_LIVE_CAPTURE=1 is set in the Dockerfile
# so dario uses the bundled template (no CC binary installed in the container).
# Keep the template current by `git pull`-ing the dario-modified fork.
# DARIO_NO_LIVE_CAPTURE=1

# ============================================
# Codex/GPT subscription (dario v6 serves Claude + Codex in one container)
# ============================================
# Obtain Codex OAuth credentials from OpenAI's codex CLI login.
# dario v6 stores them at ~/.dario/codex-accounts/<alias>.json; the tokensea
# entrypoint generates that file from these env vars on each boot.
CODEX_DARIO_1_OAUTH_ACCESS_TOKEN=
CODEX_DARIO_1_OAUTH_REFRESH_TOKEN=
CODEX_DARIO_1_OAUTH_EXPIRES_AT=
CODEX_DARIO_1_ACCOUNT_ID=codex-seat-1

# ============================================
# Team-specific settings
# ============================================
# Account type identifier (shown in /health). Use "team" for Team seats,
# "max" for Max subscriptions. Affects monitoring dashboards.
DARIO_ACCOUNT_TYPE=team
