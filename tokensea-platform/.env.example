DATABASE_URL=postgresql://tokensea:tokensea@localhost:5432/tokensea
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
# Dedicated AES-256-GCM key derivation secret for upstream provider credentials.
# Set a stable random value in production; changing it prevents decrypting saved keys.
UPSTREAM_KEY_ENCRYPTION_SECRET=change-this-to-a-long-random-secret
# Used to convert KSP's public CNY token prices into TokenSea's USD billing unit.
KSYUN_CNY_PER_USD=7.2
JWT_EXPIRES_IN=7d
PORT=3000
NODE_ENV=development

# Initial root user (used by seed script)
ROOT_USERNAME=root
ROOT_PASSWORD=tokensea2026
ROOT_EMAIL=root@tokensea.dev
